---
import {
  CHECKSUMS_URL,
  INSTALLERS,
  RELEASE,
  archivesFor,
} from "../config/distribution";
---

<div data-install>
  <div
    role="tablist"
    aria-label="Platform"
    class="mb-4 flex gap-7 text-[0.9375rem]"
  >
    {INSTALLERS.map((installer, i) => (
      <button
        type="button"
        role="tab"
        id={`install-tab-${installer.id}`}
        aria-controls={`install-panel-${installer.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-tab={installer.id}
        class="relative cursor-pointer py-1 text-muted transition-colors duration-150 after:absolute after:inset-x-0 after:-bottom-px after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 after:ease-(--ease-out-quint) hover:text-ink aria-selected:text-ink aria-selected:after:scale-x-100"
      >
        {installer.label}
      </button>
    ))}
  </div>

  {INSTALLERS.map((installer, i) => {
    const archives = archivesFor(installer.id);
    return (
      <div
        role="tabpanel"
        id={`install-panel-${installer.id}`}
        aria-labelledby={`install-tab-${installer.id}`}
        data-panel={installer.id}
        hidden={i !== 0}
      >
        <p data-panel-label class="mb-3 hidden text-[0.9375rem] text-ink">
          {installer.label}
        </p>
        <div class="flex items-center rounded-[0.875rem] border border-line-strong py-1.5 pr-1.5 pl-5 transition-colors duration-200 focus-within:border-faint hover:border-faint sm:pl-6">
          <span
            aria-hidden="true"
            class="mr-3.5 shrink-0 font-mono text-[0.9375rem] text-accent select-none"
          >
            {installer.prompt}
          </span>
          <div class="command-scroll min-w-0 flex-1" data-scroll>
            <code
              class="block py-3 pr-4 text-[0.875rem] leading-none whitespace-pre text-ink sm:text-[0.9375rem]"
              aria-label={`${installer.shell} install command`}
            >
              {installer.command}
            </code>
          </div>
          <button
            type="button"
            data-copy={installer.command}
            class="group ml-1 inline-flex h-10 min-w-10 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-[0.5rem] px-3 text-[0.8125rem] text-muted transition-colors duration-150 hover:bg-white/[0.06] hover:text-ink data-copied:text-accent"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              class="size-3.5 group-data-copied:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
            >
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
              <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" />
            </svg>
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              class="hidden size-3.5 group-data-copied:block"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="m3 8.5 3.25 3L13 4.5" />
            </svg>
            <span data-copy-label class="sr-only sm:not-sr-only">
              Copy
            </span>
            <span class="sr-only">{`${installer.label} install command`}</span>
          </button>
        </div>

        <p class="mt-4 max-w-[38rem] text-[0.9375rem] leading-relaxed text-muted">
          {installer.note}{" "}
          <a class="link" href={installer.scriptUrl}>
            Read the script
          </a>
        </p>

        {archives.length > 0 && (
          <details class="group/dl mt-3 text-[0.9375rem] text-muted">
            <summary class="w-fit cursor-pointer list-none transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
              Download a binary
              <span
                class="ml-1 inline-block transition-transform group-open/dl:rotate-90"
                aria-hidden="true"
              >
                ›
              </span>
            </summary>
            <ul class="mt-3 space-y-1.5">
              {archives.map((archive) => (
                <li class="flex flex-wrap gap-x-4">
                  <a class="link" href={archive.url}>
                    {archive.label}
                  </a>
                  <span class="font-mono text-[0.8125rem] text-faint">
                    {archive.file}
                  </span>
                </li>
              ))}
              <li>
                <a class="link" href={CHECKSUMS_URL}>
                  checksums.txt
                </a>
                <span class="text-faint"> for {RELEASE.tag}</span>
              </li>
            </ul>
          </details>
        )}
      </div>
    );
  })}

  <p class="sr-only" aria-live="polite" data-copy-status></p>
</div>

<noscript>
  <style>
    [data-install] [role="tablist"],
    [data-install] [data-copy] {
      display: none !important;
    }
    [data-install] [data-panel] {
      display: block !important;
      margin-bottom: 2rem;
    }
    [data-install] [data-panel-label] {
      display: block !important;
    }
  </style>
</noscript>

<script>
  import { initInstall } from "../scripts/install";
  initInstall();
</script>
