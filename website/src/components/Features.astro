---
const features = [
  {
    term: "Capture",
    lead: "Conversations, tokens and execution telemetry.",
    detail:
      "Reads AI tools' local data, read-only, starting with T3 Code: token usage for every turn, commands, tool calls and file changes. Message content is collected only if you opt in.",
  },
  {
    term: "Store",
    lead: "Your data, your ClickHouse instance.",
    detail:
      "Delivered over HTTP(S) to a database you run. A local spool holds data through network outages, ClickHouse downtime and reboots.",
  },
  {
    term: "Observe",
    lead: "Query and analyze your AI usage.",
    detail:
      "Ready-made views for daily token usage and tool usage. Ask anything else in plain SQL.",
  },
];
---

<section aria-labelledby="features-title" class="shell">
  <h2 id="features-title" class="sr-only">
    What Vario does
  </h2>
  <dl class="border-b border-line">
    {features.map((feature) => (
      <div class="grid grid-cols-1 gap-x-10 gap-y-3 border-t border-line py-[clamp(2.25rem,5vw,3.75rem)] md:grid-cols-12 md:items-baseline">
        <dt class="text-[clamp(2.25rem,5.2vw,4rem)] leading-none font-medium tracking-[-0.045em] text-ink md:col-span-5">
          {feature.term}
        </dt>
        <dd class="max-w-[34rem] md:col-span-7">
          <p class="text-[1.1875rem] leading-snug text-ink sm:text-[1.3125rem]">
            {feature.lead}
          </p>
          <p class="mt-3 leading-relaxed text-pretty text-muted">
            {feature.detail}
          </p>
        </dd>
      </div>
    ))}
  </dl>
</section>
