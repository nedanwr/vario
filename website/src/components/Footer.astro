---
import {
  DOCS_URL,
  LICENSE_NAME,
  LICENSE_URL,
  RELEASE,
  REPO_URL,
} from "../config/distribution";
---

<footer class="shell">
  <div class="flex flex-col gap-6 border-t border-line py-10 text-[0.9375rem] sm:flex-row sm:items-baseline sm:justify-between">
    <p class="flex items-baseline gap-3">
      <span class="text-[1.0625rem] font-semibold tracking-[-0.04em] text-ink">
        vario
      </span>
      <span class="font-mono text-[0.8125rem] text-faint">{RELEASE.tag}</span>
    </p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-7 gap-y-2">
        <li>
          <a class="nav-link" href={DOCS_URL}>
            Documentation
          </a>
        </li>
        <li>
          <a class="nav-link" href={REPO_URL}>
            GitHub
          </a>
        </li>
        <li>
          <a class="nav-link" href={LICENSE_URL}>
            {LICENSE_NAME} License
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
